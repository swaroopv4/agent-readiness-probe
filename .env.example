# No secrets or API keys are required.
ARP_AGENT=codex-cli
ARP_AUTH_METHOD=chatgpt
ARP_PAID_API_ALLOWED=false
ARP_APPROVED_BUDGET_USD=0
ARP_AGENT_TIMEOUT_SECONDS=900
ARP_COMMAND_TIMEOUT_SECONDS=120
ARP_EVALUATOR_TIMEOUT_SECONDS=300
ARP_MAX_CONCURRENT_TASKS=1
ARP_TASK_COUNT=12
ARP_DEVELOPMENT_TASKS=4
ARP_CONFIRMATION_TASKS=8
ARP_ATTEMPTS_PER_ARM=2
ARP_ENVIRONMENT_MODE=ready
