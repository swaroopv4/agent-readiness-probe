ARG BASE_IMAGE=python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements-evaluator.txt /opt/requirements.txt
RUN apt-get update \
    && apt-get install --yes --no-install-recommends less=590-2.1~deb12u2 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip download --dest /opt/wheels -r /opt/requirements.txt \
    && python -m pip install --no-index --find-links=/opt/wheels -r /opt/requirements.txt \
    && python -m pip freeze > /opt/environment.txt \
    && sha256sum /opt/wheels/* > /opt/wheel-hashes.txt
USER 1000:1000
WORKDIR /workspace
